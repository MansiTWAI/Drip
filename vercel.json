{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    { "source": "/api(/.*)?", "destination": { "type": "service", "service": "backend" } },
    { "source": "/admin/assets/(.*)", "destination": { "type": "service", "service": "admin" } },
    { "source": "/admin/products/(.*)", "destination": { "type": "service", "service": "admin" } },
    { "source": "/admin/drip-logo.png", "destination": { "type": "service", "service": "admin" } },
    { "source": "/admin", "destination": { "type": "service", "service": "admin", "path": "/index.html" } },
    { "source": "/admin/(.*)", "destination": { "type": "service", "service": "admin", "path": "/index.html" } },
    { "source": "/assets/(.*)", "destination": { "type": "service", "service": "frontend" } },
    { "source": "/products/(.*)", "destination": { "type": "service", "service": "frontend" } },
    { "source": "/drip-logo.png", "destination": { "type": "service", "service": "frontend" } },
    { "source": "/(.*)", "destination": { "type": "service", "service": "frontend", "path": "/index.html" } }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/admin/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/products/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
