{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "admin": {
            "root": "admin",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": { "service": "backend" }
        },
        {
            "source": "/admin/:path*",
            "destination": { "service": "admin", "path": "/:path*" }
        },
        {
            "source": "/(.*)",
            "destination": { "service": "frontend" }
        }
    ]
}
